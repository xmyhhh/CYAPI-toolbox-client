{
  "name": "cyapi-toolbox-client",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/core.test.ts tests/usage.test.ts tests/theme.test.ts tests/skill-collections.test.ts",
    "format": "prettier --write src tests *.json *.ts *.html README.md src-tauri/*.json",
    "theme": "node scripts/theme.mjs",
    "icons": "node scripts/create-icon.mjs && tauri icon public/app-icon.png",
    "desktop:setup": "node scripts/run.mjs setup-desktop",
    "desktop:dev": "node scripts/run.mjs desktop dev",
    "desktop:build": "node scripts/run.mjs desktop build && node scripts/run.mjs collect-release",
    "desktop:exe": "node scripts/run.mjs desktop build --no-bundle && node scripts/run.mjs collect-release --portable-only",
    "desktop:build:macos": "node scripts/run.mjs desktop build --bundles app,dmg && node scripts/run.mjs collect-release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
