  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main WebView only; remote workflow child has no native capabilities.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color"
  ]
